# Firebase Auth (Firebase console > Project settings > Your apps > Web app).
# Leave blank to run without sign-in: the app works, cloud storage stays off.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Cloudflare Worker that stores user files in R2 (verifies the Firebase ID token).
VITE_STORAGE_API_URL=

# Set to "cloud" to load part search and part images from the Worker's parts library
# instead of the local server (e.g. when the UI is hosted). Default: local.
VITE_PARTS_SOURCE=
