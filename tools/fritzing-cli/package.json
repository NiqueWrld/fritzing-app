{
  "name": "fritzing-cli",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Simple Node CLI for working with Fritzing sketches, parts, and repository files.",
  "bin": {
    "fritzing-cli": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "serve": "tsx src/index.ts serve",
    "serve:watch": "nodemon --watch src --ext ts --exec \"tsx src/index.ts serve\"",
    "dev:ui": "npm run dev --prefix ui",
    "dev:all": "concurrently -n server,ui -c blue,green \"npm run serve:watch\" \"npm run dev:ui\"",
    "mcp": "node dist/index.js --mcp"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "latest",
    "adm-zip": "^0.6.0",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "latest",
    "concurrently": "^10.0.5",
    "nodemon": "^3.1.14",
    "tsx": "latest",
    "typescript": "latest"
  }
}
